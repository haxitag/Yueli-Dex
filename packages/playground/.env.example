# =============================================================================
# Yueli DEX Playground — Environment Variables
# =============================================================================
# Copy this file to `.env.local` and fill in your real credentials.
# `.env.local` is git-ignored and will never be committed.
#
# Resolution priority (highest → lowest):
#   1. Explicit apiKey / apiToken / accountId in the provider config JSON
#   2. PLAYGROUND_* variables  (playground-specific overrides)
#   3. Default * variables      (shared with the rest of the project)
#
# Multi-key mode: append "S" to the env name and provide a comma-separated
# list. The playground will round-robin across the pool on each call (or
# pick a specific index via the provider config's `keyIndex` field).
#   e.g. TYPESAFE_API_KEYS=sk_aaa,sk_bbb,sk_ccc
# =============================================================================

# ── HTTP / self-hosted jev-choice provider ───────────────────────────────────
# Single key (bearer token sent as Authorization header)
DEX_HTTP_API_KEY=
# Multiple keys (time-based distribution across the pool)
DEX_HTTP_API_KEYS=
# Legacy alias (still accepted at runtime):
# HTTP_PROVIDER_API_KEY=

# ── TypeSafe System One provider ─────────────────────────────────────────────
TYPESAFE_API_KEY=
TYPESAFE_API_KEYS=

# ── Cloudflare Workers AI provider ───────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_API_TOKENS=

# ── Vercel AI Gateway provider ───────────────────────────────────────────────
VERCEL_API_TOKEN=
VERCEL_API_TOKENS=

# ── L3 LLM 模板生成（可选，OPENAI 兼容接口）─────────────────────────────────
# 配置后 L3 层用 LLM 生成场景效用模板；未配置时使用确定性脚手架生成
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# ── Playground-specific overrides (optional) ─────────────────────────────────
# Set these to use a different key set for the playground only, while keeping
# the default * variables for production / other packages.
#
# PLAYGROUND_DEX_HTTP_API_KEY=
# PLAYGROUND_DEX_HTTP_API_KEYS=
# PLAYGROUND_TYPESAFE_API_KEY=
# PLAYGROUND_TYPESAFE_API_KEYS=
# PLAYGROUND_CLOUDFLARE_ACCOUNT_ID=
# PLAYGROUND_CLOUDFLARE_API_TOKEN=
# PLAYGROUND_CLOUDFLARE_API_TOKENS=
# PLAYGROUND_VERCEL_API_TOKEN=
# PLAYGROUND_VERCEL_API_TOKENS=
